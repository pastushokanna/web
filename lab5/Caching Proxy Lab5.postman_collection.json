          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "\r\npm.test(\"Status 201 Created\", () => {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Content-Type text/plain\", () => {\r\n    pm.expect(pm.response.headers.get(\"Content-Type\"))\r\n        .to.include(\"text/plain\");\r\n});\r\n\r\npm.test(\"Correct response message\", () => {\r\n    pm.expect(pm.response.text())\r\n        .to.include(\"Kartynku dlya kodu 418 zberezheno v kesh.\");\r\n});\r\n\r\n"
            ]
          }
        }
